<style>
    /* Base Sidebar Styling */
    #sidebar-wrapper {
        width: 270px;
        min-width: 270px;
        background: #0f172a !important; /* Deep Slate Modern Navy */
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.3s cubic-bezier(0.4, 0, 0.2, 1), margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1040;
        display: flex;
        flex-direction: column;
        box-shadow: 4px 0 24px rgba(0, 0, 0, 0.2);
    }

    .brand-icon-box {
        width: 42px;
        height: 42px;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.45);
        transition: all 0.3s ease;
    }

    .sidebar-category {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #94a3b8 !important;
        padding: 0.9rem 0.6rem 0.35rem;
        opacity: 0.9;
        transition: opacity 0.2s ease;
    }

    .sidebar-nav-item, .sidebar-nav-link {
        display: flex !important;
        width: 100% !important;
        align-items: center !important;
        margin: 0.3rem 0 !important;
        border-radius: 12px !important;
        color: #cbd5e1 !important;
        padding: 11px 16px !important;
        text-decoration: none !important;
        font-size: 0.92rem;
        font-weight: 500;
        transition: all 0.2s ease !important;
        background: transparent;
        position: relative;
    }

    .sidebar-nav-item .nav-icon, .sidebar-nav-link .nav-icon {
        font-size: 1.15rem;
        margin-right: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        color: #94a3b8;
        transition: all 0.2s ease;
    }

    .sidebar-nav-item:hover, .sidebar-nav-link:hover {
        background: rgba(255, 255, 255, 0.08) !important;
        color: #ffffff !important;
        transform: translateX(4px);
    }

    .sidebar-nav-item:hover .nav-icon, .sidebar-nav-link:hover .nav-icon {
        color: #ffffff;
        transform: scale(1.1);
    }

    .sidebar-nav-item.active, .sidebar-nav-link.active {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%) !important;
        color: #ffffff !important;
        font-weight: 600;
        box-shadow: 0 4px 16px rgba(79, 70, 229, 0.45);
    }

    .sidebar-nav-item.active .nav-icon, .sidebar-nav-link.active .nav-icon {
        color: #ffffff !important;
    }

    .sidebar-footer-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        transition: all 0.3s ease;
    }

    .avatar-admin-sidebar {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: #ffffff;
        font-weight: 700;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(79, 70, 229, 0.35);
    }

    /* ========================================================
       ⭐ MINI SIDEBAR (KHI THU GỌN - CHỈ GIỮ LẠI 1 CỘT DỌC ICON)
       ======================================================== */
    @@media (min-width: 769px) {
        #wrapper.toggled #sidebar-wrapper {
            width: 80px !important;
            min-width: 80px !important;
            margin-left: 0 !important;
        }

        /* Ẩn chữ ở Brand Header, chỉ giữ icon căn giữa */
        #wrapper.toggled .sidebar-brand {
            padding: 1.25rem 0.5rem !important;
            justify-content: center !important;
        }
        #wrapper.toggled .brand-text-box {
            display: none !important;
        }
        #wrapper.toggled .brand-icon-box {
            margin-right: 0 !important;
        }

        /* Danh mục: ẩn chữ khi thu gọn, thay bằng đường divider nhỏ */
        #wrapper.toggled .sidebar-category {
            display: none !important;
        }
        #wrapper.toggled .sidebar-divider-mini {
            display: block !important;
            height: 1px;
            background: rgba(255, 255, 255, 0.1);
            margin: 0.8rem 0.5rem;
        }

        /* Căn giữa icon của từng menu item */
        #wrapper.toggled .sidebar-nav-container {
            padding: 0.75rem 0.5rem !important;
        }
        #wrapper.toggled .sidebar-nav-item,
        #wrapper.toggled .sidebar-nav-link {
            padding: 12px 0 !important;
            justify-content: center !important;
            margin: 0.4rem 0 !important;
        }
        #wrapper.toggled .sidebar-nav-item:hover,
        #wrapper.toggled .sidebar-nav-link:hover {
            transform: none !important;
            background: rgba(255, 255, 255, 0.12) !important;
        }
        #wrapper.toggled .sidebar-nav-item .nav-text,
        #wrapper.toggled .sidebar-nav-link .nav-text {
            display: none !important;
        }
        #wrapper.toggled .sidebar-nav-item .nav-icon,
        #wrapper.toggled .sidebar-nav-link .nav-icon {
            margin-right: 0 !important;
            font-size: 1.35rem !important;
        }

        /* Chấm đỏ thông báo nhỏ gọn khi thu nhỏ */
        #wrapper.toggled .sidebar-nav-item .badge-count,
        #wrapper.toggled .sidebar-nav-link .badge-count {
            position: absolute !important;
            top: 6px !important;
            right: 14px !important;
            width: 9px !important;
            height: 9px !important;
            padding: 0 !important;
            border-radius: 50% !important;
            font-size: 0 !important;
            border: 2px solid #0f172a;
        }

        /* Chân sidebar khi thu nhỏ */
        #wrapper.toggled .sidebar-footer-card {
            margin: 10px 8px !important;
            padding: 10px 0 !important;
        }
        #wrapper.toggled .footer-user-text {
            display: none !important;
        }
        #wrapper.toggled .footer-flex-box {
            flex-direction: column !important;
            justify-content: center !important;
            gap: 10px !important;
        }
    }

    /* Trên màn hình điện thoại (<= 768px) */
    @@media (max-width: 768px) {
        #sidebar-wrapper {
            margin-left: -270px;
            position: fixed;
            height: 100vh;
        }
        #wrapper.toggled #sidebar-wrapper {
            margin-left: 0 !important;
            width: 270px !important;
            min-width: 270px !important;
        }
    }
</style>

<div id="sidebar-wrapper">
    <!-- Brand Header -->
    <div class="sidebar-brand d-flex align-items-center px-4 py-4 border-bottom border-secondary border-opacity-25">
        <div class="brand-icon-box me-3 flex-shrink-0" title="ĐOÀN HUTECH">
            <i class="bi bi-shield-check fs-4 text-white"></i>
        </div>
        <div class="overflow-hidden brand-text-box">
            <h6 class="fw-bold text-white mb-0 text-truncate" style="letter-spacing: 0.5px; font-size: 1.05rem;">ĐOÀN HUTECH</h6>
            <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25 rounded-pill" style="font-size: 0.65rem; padding: 2px 8px;">ADMIN PORTAL</span>
        </div>
    </div>

    <!-- Navigation List -->
    <div class="sidebar-nav-container px-3 py-3 flex-grow-1 overflow-auto">
        <div class="sidebar-category text-uppercase fw-bold">Quản lý hoạt động</div>
        
        <a asp-controller="Admin" asp-action="Index" class="sidebar-nav-item sidebar-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" title="Tổng quan">
            <i class="bi bi-grid-1x2-fill nav-icon"></i>
            <span class="nav-text">Tổng quan</span>
        </a>
        <a asp-controller="Admin" asp-action="HoatDong" class="sidebar-nav-item sidebar-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "HoatDong" ? "active" : "")" title="QL Hoạt động">
            <i class="bi bi-calendar-check-fill nav-icon"></i>
            <span class="nav-text">QL Hoạt động</span>
        </a>
        <a asp-controller="Admin" asp-action="SinhVien" class="sidebar-nav-item sidebar-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "SinhVien" ? "active" : "")" title="QL Sinh viên">
            <i class="bi bi-people-fill nav-icon"></i>
            <span class="nav-text">QL Sinh viên</span>
        </a>

        <div class="sidebar-divider-mini d-none"></div>
        <div class="sidebar-category text-uppercase fw-bold mt-4">Giao tiếp & Tương tác</div>

        <a asp-controller="Chat" asp-action="Index" class="sidebar-nav-item sidebar-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Chat" ? "active" : "")" title="Tin nhắn">
            <i class="bi bi-chat-quote-fill nav-icon"></i>
            <span class="nav-text">Tin nhắn</span>
            @if (ViewBag.TinNhanMoi != null && ViewBag.TinNhanMoi > 0)
            {
                <span class="badge bg-danger rounded-pill ms-auto px-2 py-1 badge-count" style="font-size: 0.7rem;">@ViewBag.TinNhanMoi</span>
            }
        </a>
    </div>

    <!-- User Profile Footer -->
    <div class="sidebar-footer-card p-3 m-3 rounded-4 border border-secondary border-opacity-25">
        <div class="d-flex align-items-center justify-content-between gap-2 footer-flex-box">
            <div class="d-flex align-items-center gap-2 overflow-hidden">
                <div class="avatar-admin-sidebar rounded-circle flex-shrink-0" title="Quản Trị Viên (admin@hutech.edu.vn)">AD</div>
                <div class="overflow-hidden footer-user-text">
                    <div class="fw-bold text-white small text-truncate">Quản Trị Viên</div>
                    <div class="text-white-50 text-truncate" style="font-size: 0.72rem;">admin@hutech.edu.vn</div>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center p-0 flex-shrink-0" title="Đăng xuất" style="width: 34px; height: 34px;">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
