<nav class="navbar navbar-expand-lg top-navbar px-4 py-3 sticky-top">
    <div class="d-flex align-items-center gap-3">
        <!-- Nút Toggle Sidebar -->
        <button class="btn btn-toggle-sidebar" id="menu-toggle" type="button" aria-label="Toggle Sidebar">
            <i class="bi bi-list fs-5"></i>
        </button>

        <!-- Search Bar -->
        <div class="top-search-box d-none d-md-flex align-items-center">
            <i class="bi bi-search text-muted me-2"></i>
            <input type="text" class="form-control form-control-sm border-0 bg-transparent shadow-none p-0" placeholder="Tìm nhanh sinh viên, hoạt động...">
        </div>
    </div>

    <div class="d-flex align-items-center ms-auto gap-3">
        <!-- Live Date Badge -->
        <div class="d-none d-lg-flex align-items-center gap-2 text-muted small bg-white px-3 py-2 rounded-pill border shadow-sm">
            <i class="bi bi-calendar3 text-primary"></i>
            <span id="currentDateDisplay">Hôm nay</span>
        </div>

        <!-- Notification Dropdown -->
        <div class="dropdown">
            <button class="btn btn-icon-round position-relative" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thông báo">
                <i class="bi bi-bell-fill fs-5"></i>
                @if (ViewBag.TinNhanMoi != null && ViewBag.TinNhanMoi > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle pulse-badge" style="width: 10px; height: 10px;">
                        <span class="visually-hidden">New alerts</span>
                    </span>
                }
            </button>
            <ul class="dropdown-menu dropdown-menu-end dropdown-notifications p-0 shadow-lg border-0" aria-labelledby="notifDropdown">
                <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                    <span class="fw-bold text-dark">Thông báo</span>
                    @if (ViewBag.TinNhanMoi != null && ViewBag.TinNhanMoi > 0)
                    {
                        <span class="badge bg-danger rounded-pill">@ViewBag.TinNhanMoi mới</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill">0 mới</span>
                    }
                </li>
                <div style="max-height: 280px; overflow-y: auto;">
                    @if (ViewBag.TinNhanMoi != null && ViewBag.TinNhanMoi > 0)
                    {
                        <a asp-controller="Chat" asp-action="Index" class="dropdown-item p-3 border-bottom d-flex align-items-center gap-3 notification-row">
                            <div class="bg-warning-subtle text-warning rounded-circle p-2 flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-chat-dots-fill fs-5"></i>
                            </div>
                            <div class="overflow-hidden">
                                <p class="fw-semibold text-dark small mb-0">Tin nhắn mới từ Sinh viên</p>
                                <small class="text-muted text-truncate d-block">Bạn có @ViewBag.TinNhanMoi tin nhắn cần phản hồi</small>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-bell-slash fs-3 d-block mb-1 opacity-50"></i>
                            <small>Không có thông báo mới</small>
                        </div>
                    }
                </div>
                <li>
                    <a class="dropdown-item py-2 text-center text-primary fw-semibold small bg-light border-top" asp-controller="Chat" asp-action="Index">
                        Xem hộp thư tin nhắn <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </div>

        <div class="vr mx-1 opacity-25" style="height: 24px;"></div>

        <!-- User Profile Dropdown -->
        <div class="dropdown">
            <button class="btn p-0 d-flex align-items-center gap-2 border-0 bg-transparent shadow-none" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="user-avatar-top shadow-sm">AD</div>
                <div class="text-start d-none d-md-block">
                    <div class="fw-bold text-dark small mb-0" style="line-height: 1.2;">Admin</div>
                    <small class="text-muted" style="font-size: 0.75rem;">Quản trị viên</small>
                </div>
                <i class="bi bi-chevron-down text-muted small ms-1"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2" style="min-width: 200px;">
                <li class="px-3 py-2 border-bottom">
                    <span class="d-block fw-bold text-dark small">Quản Trị Viên</span>
                    <span class="text-muted" style="font-size: 0.75rem;">admin@hutech.edu.vn</span>
                </li>
                <li>
                    <a class="dropdown-item py-2 rounded-3 small mt-1" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 rounded-3 small" asp-controller="Chat" asp-action="Index">
                        <i class="bi bi-chat-left-dots me-2 text-info"></i> Hộp thư chat
                    </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    <a class="dropdown-item py-2 rounded-3 small text-danger fw-semibold" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
