@{
    ViewData["Title"] = "Tổng quan hệ thống";
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --warning-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        --info-gradient: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
    }

    .dashboard-header {
        background: #ffffff;
        border-radius: 20px;
        padding: 24px 28px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        border: 1px solid rgba(226, 232, 240, 0.8);
    }

    /* Modern Bento Stat Cards */
    .bento-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 20px;
        padding: 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        position: relative;
        overflow: hidden;
    }

    .bento-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(79, 70, 229, 0.08);
        border-color: rgba(99, 102, 241, 0.3);
    }

    .icon-badge {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .badge-soft-primary { background: #eef2ff; color: #4f46e5; }
    .badge-soft-success { background: #ecfdf5; color: #10b981; }
    .badge-soft-warning { background: #fffbeb; color: #f59e0b; }
    .badge-soft-info    { background: #f0fdf4; color: #06b6d4; }

    .trend-pill {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 30px;
    }

    .card-title-sub {
        font-size: 0.875rem;
        font-weight: 600;
        color: #64748b;
    }

    .metric-value {
        font-size: 2.25rem;
        font-weight: 800;
        color: #1e293b;
        line-height: 1.2;
    }

    /* Content Cards */
    .content-box {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        padding: 24px;
    }

    .quick-action-btn {
        border-radius: 14px;
        padding: 10px 18px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
</style>

<!-- Header Chào mừng & Action nhanh -->
<div class="dashboard-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1">Tổng quan hoạt động Đoàn 🌟</h3>
        <p class="text-muted mb-0 small">Chào mừng trở lại, chúc bạn một ngày làm việc hiệu quả!</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary quick-action-btn shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Tạo hoạt động
        </a>
        <a asp-action="SinhVien" class="btn btn-light quick-action-btn border text-secondary">
            <i class="bi bi-person-lines-fill"></i> QL Sinh viên
        </a>
    </div>
</div>

<!-- 4 Thẻ Bento KPI Thống kê -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="bento-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <span class="card-title-sub">Hoạt động Đoàn</span>
                <div class="icon-badge badge-soft-primary">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
            </div>
            <div class="metric-value mb-2">@ViewBag.SoLuongHoatDong</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="trend-pill bg-success-subtle text-success">
                    <i class="bi bi-arrow-up-short"></i> Hoạt động
                </span>
                <a asp-action="HoatDong" class="text-decoration-none small fw-semibold text-primary">Chi tiết <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="bento-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <span class="card-title-sub">Lượt đăng ký</span>
                <div class="icon-badge badge-soft-success">
                    <i class="bi bi-ticket-perforated-fill"></i>
                </div>
            </div>
            <div class="metric-value mb-2">@ViewBag.SoLuongDangKy</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="trend-pill bg-success-subtle text-success">
                    <i class="bi bi-lightning-charge-fill"></i> Realtime
                </span>
                <span class="text-muted small">Toàn hệ thống</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="bento-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <span class="card-title-sub">Tổng sinh viên</span>
                <div class="icon-badge badge-soft-warning">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="metric-value mb-2">@ViewBag.SoLuongSinhVien</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="trend-pill bg-warning-subtle text-warning">Đoàn viên</span>
                <a asp-action="SinhVien" class="text-decoration-none small fw-semibold text-warning">Quản lý <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="bento-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <span class="card-title-sub">Tin nhắn chưa đọc</span>
                <div class="icon-badge badge-soft-info">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>
            </div>
            <div class="metric-value mb-2">@(ViewBag.TinNhanMoi ?? 0)</div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="trend-pill bg-info-subtle text-info">Hỗ trợ</span>
                <a asp-controller="Chat" asp-action="Index" class="text-decoration-none small fw-semibold text-info">Hộp thư <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<!-- Khối Biểu đồ & Thông báo -->
<div class="row g-4">
    <!-- Chart Box -->
    <div class="col-lg-8">
        <div class="content-box h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1 text-dark">Thống kê tương tác theo tháng</h5>
                    <p class="text-muted small mb-0">Lượt đăng ký tham gia hoạt động trong 6 tháng gần nhất</p>
                </div>
            </div>
            <div style="height: 330px;">
                <canvas id="mainDashboardChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Thông báo mới -->
    <div class="col-lg-4">
        <div class="content-box h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">Hoạt động mới nhất</h5>
                <a asp-action="HoatDong" class="text-muted small text-decoration-none">Tất cả</a>
            </div>
            <div class="list-group list-group-flush flex-grow-1">
                @if (ViewBag.ThongBaoMoi != null && ((List<HoatDong>)ViewBag.ThongBaoMoi).Any())
                {
                    @foreach (var item in (List<HoatDong>)ViewBag.ThongBaoMoi)
                    {
                        <div class="list-group-item border-0 px-0 py-3 d-flex align-items-center gap-3">
                            <div class="bg-primary-subtle text-primary rounded-4 p-3 flex-shrink-0">
                                <i class="bi bi-flag-fill fs-5"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold text-truncate mb-1 text-dark" title="@item.TenHoatDong">@item.TenHoatDong</h6>
                                <div class="d-flex align-items-center gap-2">
                                    @if (item.TrangThai == "DangDienRa")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Đang diễn ra</span>
                                    }
                                    else if (item.TrangThai == "SapDienRa")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">Sắp diễn ra</span>
                                    }
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i> @item.ThoiGianBatDau.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 my-auto text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                        <span>Chưa có hoạt động mới</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const chartLabels = @Html.Raw(ViewBag.ChartLabels ?? "[]"); 
        const chartData = @Html.Raw(ViewBag.ChartData ?? "[]");

        const ctx = document.getElementById('mainDashboardChart').getContext('2d');
        
        // Gradient fill cho biểu đồ mềm mại
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(79, 70, 229, 0.35)');
        gradient.addColorStop(1, 'rgba(79, 70, 229, 0.0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels, 
                datasets: [{
                    label: 'Số lượng đăng ký',
                    data: chartData, 
                    borderColor: '#4f46e5',
                    borderWidth: 3,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#4f46e5',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        padding: 12,
                        titleFont: { size: 13, weight: 'bold' },
                        bodyFont: { size: 12 },
                        cornerRadius: 10,
                        displayColors: false
                    }
                },
                scales: {
                    y: { 
                        beginAtZero: true, 
                        border: { display: false },
                        grid: { color: 'rgba(241, 245, 249, 1)' } 
                    },
                    x: { 
                        border: { display: false }, 
                        grid: { display: false } 
                    }
                }
            }
        });
    </script>
}
