{
  "name": "doan-vien-api-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống Quản lý Đoàn viên & Hoạt động - Backend .NET 9 & Next.js 15 với Prisma ORM",
  "scripts": {
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:setup": "prisma migrate deploy && node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
